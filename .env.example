# ============================================
# CyberTrace Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control!

# LLM Provider Configuration (Phase 9 - Optional, fallback engine active if unset)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Log level for the application (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Streamlit server settings (optional overrides)
# STREAMLIT_SERVER_PORT=8501
